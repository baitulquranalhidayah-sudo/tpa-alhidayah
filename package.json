{
  "name": "tpa-alhidayah",
  "version": "1.0.0",
  "private": true,
  "description": "Website Baitul Qur'an Al-Hidayah — Desa Keluang, Kec. Kuaro, Kab. Paser",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "serve": "python3 -m http.server 8080",
    "live": "node tools/dev-server.mjs",
    "dev": "node tools/dev-server.mjs & npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
